# ML Studio Environment Configuration
PROJECT_NAME="ML Studio"
API_V1_STR="/api"
ENVIRONMENT="development"

# Storage Paths (defaults to local relative paths)
DATA_DIR="artifacts/datasets"
ARTIFACTS_DIR="artifacts/models"
